# ============================================================
# JIRA INTELLIGENCE PLATFORM — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Jira Connection ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_AUTH_TYPE=api_token          # api_token | pat | oauth2
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your_api_token_here
# For Data Center PAT:
# JIRA_PAT=your_personal_access_token
# For OAuth2:
# JIRA_CLIENT_ID=...
# JIRA_CLIENT_SECRET=...

# --- Database ---
DATABASE_URL=postgresql://jirauser:jirapass@localhost:5432/jira_intelligence
# For SQLite MVP:
# DATABASE_URL=sqlite:///./jira_intelligence.db

# --- Redis (optional, for caching) ---
REDIS_URL=redis://localhost:6379/0

# --- Application ---
APP_ENV=development               # development | staging | production
APP_SECRET_KEY=change_me_to_random_256bit_key
ALLOWED_ORIGINS=*                 # Comma-separated: https://app.company.com,https://admin.company.com
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./logs/audit.log

# --- Scheduler ---
SCHEDULER_ENABLED=true
EXTRACT_CRON_DAILY=0 2 * * *      # Every day at 02:00
SNAPSHOT_RETENTION_DAYS=400

# --- Jira Customfield IDs (adjust for your Jira instance) ---
JIRA_FIELD_EPIC_LINK=customfield_10014
JIRA_FIELD_STORY_POINTS=customfield_10016
JIRA_FIELD_SPRINT=customfield_10020

# --- Jira API Limits ---
JIRA_PAGE_SIZE=100
JIRA_MAX_RESULTS=50000
JIRA_RATE_LIMIT_DELAY=0.3         # seconds between requests
JIRA_RETRY_ATTEMPTS=3
JIRA_RETRY_BACKOFF=2.0

# --- Feature Flags ---
ENABLE_NLP_ANALYSIS=false         # Requires spacy
ENABLE_DUPLICATE_DETECTION=false
ENABLE_PDF_EXPORT=false
